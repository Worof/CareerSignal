# ── Supabase (required) ───────────────────────────────────────────────
# Project Settings → API. The publishable (anon) key is safe for the browser
# because every table and bucket is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used ONLY by the account-deletion route handler.
# Never prefix with NEXT_PUBLIC_. Leave empty to disable account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────
# Used for auth e-mail redirects. Falls back to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI provider (optional) ────────────────────────────────────────────
# The app is fully usable without these: manual entry, CRUD, dashboards and
# the Audience Fit Score never call an AI provider.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ── Feature flags ─────────────────────────────────────────────────────
# Official LinkedIn API integration. Disabled by default (see docs/ARCHITECTURE.md).
LINKEDIN_API_ENABLED=false
